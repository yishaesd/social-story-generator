* text=auto

# 脚本与数据统一 LF，避免 Windows 上钩子/校验脚本带 CRLF 出怪问题
*.sh      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.css     text eol=lf
.githooks/* text eol=lf

# 图片按二进制处理，别做文本 diff
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
